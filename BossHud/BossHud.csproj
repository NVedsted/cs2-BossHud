<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>0.0.2</Version>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!--<DefineConstants>HITMARKER</DefineConstants>-->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CounterStrikeSharp.API" Version="1.0.370" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="cs2-HitMarkApi" Condition="$(DefineConstants.Contains('HITMARKER'))">
            <HintPath>...</HintPath>
        </Reference>
    </ItemGroup>

</Project>
